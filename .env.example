# Pixelle-Video local secrets (example only)
# NOTE: project does not auto-load .env by default; export these in your shell or map into config.yaml manually.

DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
RUNNINGHUB_API_KEY=YOUR_RUNNINGHUB_API_KEY

# Optional overrides recognized in code paths
COMFYUI_BASE_URL=http://127.0.0.1:8188
RUNNINGHUB_INSTANCE_TYPE=YOUR_RUNNINGHUB_REGION_OR_INSTANCE_TYPE
PIXELLE_VIDEO_ROOT=.
